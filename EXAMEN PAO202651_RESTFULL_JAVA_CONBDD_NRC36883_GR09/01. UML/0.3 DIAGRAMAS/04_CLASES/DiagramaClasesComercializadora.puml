@startuml
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #1F2A6B
skinparam ArrowFontColor #8B1A1A
skinparam ArrowFontSize 11
skinparam ActorBorderColor #1F2A6B
skinparam ActorBackgroundColor #FCF8E8
skinparam UsecaseBorderColor #1F2A6B
skinparam UsecaseBackgroundColor #FCF8E8
skinparam RectangleBorderColor #1F2A6B
skinparam PackageBorderColor #1F2A6B
skinparam ComponentBorderColor #1F2A6B
skinparam ComponentBackgroundColor #FFF7DC
skinparam NodeBorderColor #1F2A6B
skinparam NodeBackgroundColor #FFFFFF
skinparam DatabaseBorderColor #1F2A6B
skinparam DatabaseBackgroundColor #FFF7DC
skinparam ClassBorderColor #1F2A6B
skinparam ClassBackgroundColor #FCF8E8
skinparam ClassHeaderBackgroundColor #FFF7DC
skinparam EntityBorderColor #1F2A6B
skinparam EntityBackgroundColor #FCF8E8
skinparam ActivityBorderColor #1F2A6B
skinparam ActivityBackgroundColor #FCF8E8
skinparam ActivityDiamondBorderColor #1F2A6B
skinparam ActivityDiamondBackgroundColor #FFF7DC
skinparam SwimlaneBorderColor #1F2A6B
skinparam SequenceLifeLineBorderColor #1F2A6B
skinparam ParticipantBorderColor #1F2A6B
skinparam ParticipantBackgroundColor #FCF8E8
skinparam SequenceGroupBorderColor #1F2A6B
skinparam NoteBorderColor #1F2A6B
skinparam NoteBackgroundColor #FFFFFF
skinparam TitleFontSize 16
title Diagrama de clases — Servidor WS_COM_CEL_JAVA_REST
hide empty members

package "controladores" {
  class PhoneResource <<JAX-RS /phones>> {
    +listarCelulares(todos: boolean): Response
    +obtenerCelular(codCelular: Integer): Response
    +crearCelular(celular: Celular): Response
    +actualizarCelular(codCelular: Integer, celular: Celular): Response
    +eliminarCelular(codCelular: Integer): Response
  }
  class InvoiceResource <<JAX-RS /invoices>> {
    +facturar(solicitud: FacturaRequest): Response
    +listarFacturas(cedula: String): Response
    +obtenerFactura(codFactura: Integer): Response
  }
  class CreditResource <<JAX-RS /credits>> {
    +listarCreditos(cedula: String): Response
    +obtenerTablaAmortizacion(codCredito: Integer): Response
  }
  class RestResponseMapper {
    +{static} respuesta(r: Respuesta): Response
  }
}

package "servicios" {
  class CatalogoServices {
    +listarCelulares(incluirRetirados: boolean): Respuesta
    +obtenerCelular(cod: Integer): Respuesta
    +crearCelular(datos: Celular): Respuesta
    +actualizarCelular(cod: Integer, datos: Celular): Respuesta
    +eliminarCelular(cod: Integer): Respuesta
  }
  class FacturacionServices {
    +DESCUENTO_EFECTIVO: BigDecimal = 0.42
    +CUOTAS_MINIMAS: int = 3
    +CUOTAS_MAXIMAS: int = 18
    +facturar(solicitud: FacturaRequest): Respuesta
    -facturarCredito(f: Factura, cuotas: int): Respuesta
    +obtenerFactura(cod: Integer): Respuesta
    +listarFacturas(cedula: String): Respuesta
    +listarCreditos(cedula: String): Respuesta
    +obtenerTablaAmortizacion(codCredito: Integer): Respuesta
  }
}

package "integracion" {
  interface ServicioBanco {
    +verificarSujetoCredito(cedula: String): Respuesta
    +obtenerMontoMaximo(codCliente: int): Respuesta
    +otorgarCredito(codCliente: int, precio: BigDecimal, cuotas: int): Respuesta
    +obtenerTablaAmortizacion(codCredito: int): Respuesta
    +listarCreditos(cedula: String): Respuesta
  }
  class ClienteBanquitoRest {
    -urlBase: String
    -http: HttpClient
  }
  class BancoNoDisponibleException
}

package "datos" {
  interface RepositorioComercializadora {
    +listarCelulares(soloDisponibles: boolean): List<Celular>
    +buscarCelular(cod: int): Celular
    +crearCelular(c: Celular): int
    +actualizarCelular(c: Celular): void
    +retirarCelular(cod: int): void
    +registrarFactura(f: Factura): int
    +buscarFactura(cod: int): Factura
    +listarFacturas(cedula: String): List<Factura>
  }
  class RepositorioComercializadoraJdbc
}

package "modelos" {
  class Celular {
    -codCelular: Integer
    -marca: String
    -modelo: String
    -descripcion: String
    -precio: BigDecimal
    -disponible: Boolean
  }
  class Factura {
    -codFactura: Integer
    -cedula: String
    -nombre: String
    -fecha: String
    -formaPago: String
    -subtotal: BigDecimal
    -descuento: BigDecimal
    -total: BigDecimal
    -codCredito: Integer
    -numeroCuotas: Integer
    -valorCuota: BigDecimal
  }
  class DetalleFactura {
    -codCelular: Integer
    -marca: String
    -modelo: String
    -cantidad: Integer
    -precioUnitario: BigDecimal
    -subtotal: BigDecimal
  }
  class FacturaRequest {
    -cedula: String
    -nombre: String
    -formaPago: String
    -numeroCuotas: Integer
  }
  class Respuesta {
    -estado: String
    -codigo: String
    -mensaje: String
    +esExito(): boolean
  }
  class Credito
  class CuotaAmortizacion
}

PhoneResource --> CatalogoServices
InvoiceResource --> FacturacionServices
CreditResource --> FacturacionServices
PhoneResource ..> RestResponseMapper
InvoiceResource ..> RestResponseMapper
CreditResource ..> RestResponseMapper
CatalogoServices --> RepositorioComercializadora
FacturacionServices --> RepositorioComercializadora
FacturacionServices --> ServicioBanco
ClienteBanquitoRest ..|> ServicioBanco
ClienteBanquitoRest ..> BancoNoDisponibleException
RepositorioComercializadoraJdbc ..|> RepositorioComercializadora
Factura "1" *-- "1..*" DetalleFactura
FacturaRequest "1" o-- "1..*" DetalleFactura
Respuesta --> Factura
Respuesta --> Celular
Respuesta --> Credito
Respuesta --> CuotaAmortizacion
RestResponseMapper -[hidden]down-> CatalogoServices
CatalogoServices -[hidden]down-> RepositorioComercializadora
FacturacionServices -[hidden]down-> ServicioBanco
RepositorioComercializadora -[hidden]down-> Celular
ServicioBanco -[hidden]down-> Factura
@enduml
