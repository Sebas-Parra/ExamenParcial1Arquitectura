@startuml
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #1F2A6B
skinparam ArrowFontColor #8B1A1A
skinparam ArrowFontSize 11
skinparam ActorBorderColor #1F2A6B
skinparam ActorBackgroundColor #FCF8E8
skinparam UsecaseBorderColor #1F2A6B
skinparam UsecaseBackgroundColor #FCF8E8
skinparam RectangleBorderColor #1F2A6B
skinparam PackageBorderColor #1F2A6B
skinparam ComponentBorderColor #1F2A6B
skinparam ComponentBackgroundColor #FFF7DC
skinparam NodeBorderColor #1F2A6B
skinparam NodeBackgroundColor #FFFFFF
skinparam DatabaseBorderColor #1F2A6B
skinparam DatabaseBackgroundColor #FFF7DC
skinparam ClassBorderColor #1F2A6B
skinparam ClassBackgroundColor #FCF8E8
skinparam ClassHeaderBackgroundColor #FFF7DC
skinparam EntityBorderColor #1F2A6B
skinparam EntityBackgroundColor #FCF8E8
skinparam ActivityBorderColor #1F2A6B
skinparam ActivityBackgroundColor #FCF8E8
skinparam ActivityDiamondBorderColor #1F2A6B
skinparam ActivityDiamondBackgroundColor #FFF7DC
skinparam SwimlaneBorderColor #1F2A6B
skinparam SequenceLifeLineBorderColor #1F2A6B
skinparam ParticipantBorderColor #1F2A6B
skinparam ParticipantBackgroundColor #FCF8E8
skinparam SequenceGroupBorderColor #1F2A6B
skinparam NoteBorderColor #1F2A6B
skinparam NoteBackgroundColor #FFFFFF
skinparam TitleFontSize 16
title Casos de uso — Módulo de Crédito del Banco BanQuito
 
left to right direction
actor "Sistema de la\nComercializadora" as COM

rectangle "MÓDULO DE CRÉDITO BANQUITO (WS_BANQUITO_JAVA_REST)" {
  usecase "CU-01 Verificar si es\nsujeto de crédito" as CU01
  usecase "CU-02 Verificar que sea\ncliente del banco" as CU02
  usecase "CU-03 Verificar depósito\nen el último mes" as CU03
  usecase "CU-04 Verificar edad mínima\n(25 años, género masculino)" as CU04
  usecase "CU-05 Verificar que no tenga\ncrédito activo" as CU05
  usecase "CU-06 Obtener monto\nmáximo de crédito" as CU06
  usecase "CU-07 Calcular promedios de\ndepósitos y retiros (3 meses)" as CU07
  usecase "CU-08 Otorgar crédito" as CU08
  usecase "CU-09 Generar tabla de\namortización (cuota fija)" as CU09
  usecase "CU-10 Registrar crédito y\ntabla de amortización" as CU10
  usecase "CU-11 Rechazar solicitud\nde crédito" as CU11
  usecase "CU-12 Consultar tabla\nde amortización" as CU12
  usecase "CU-13 Consultar créditos\ndel cliente" as CU13
}

COM --> CU01
COM --> CU06
COM --> CU08
COM --> CU12
COM --> CU13

CU01 ..> CU02 : <<include>>
CU01 ..> CU03 : <<include>>
CU01 ..> CU04 : <<include>>
CU01 ..> CU05 : <<include>>
CU06 ..> CU07 : <<include>>
CU08 ..> CU01 : <<include>>
CU08 ..> CU06 : <<include>>
CU08 ..> CU09 : <<include>>
CU08 ..> CU10 : <<include>>
CU11 ..> CU08 : <<extend>>
@enduml
