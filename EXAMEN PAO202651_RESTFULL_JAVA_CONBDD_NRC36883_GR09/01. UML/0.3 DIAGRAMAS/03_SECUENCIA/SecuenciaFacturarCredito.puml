@startuml
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #1F2A6B
skinparam ArrowFontColor #8B1A1A
skinparam ArrowFontSize 11
skinparam ActorBorderColor #1F2A6B
skinparam ActorBackgroundColor #FCF8E8
skinparam UsecaseBorderColor #1F2A6B
skinparam UsecaseBackgroundColor #FCF8E8
skinparam RectangleBorderColor #1F2A6B
skinparam PackageBorderColor #1F2A6B
skinparam ComponentBorderColor #1F2A6B
skinparam ComponentBackgroundColor #FFF7DC
skinparam NodeBorderColor #1F2A6B
skinparam NodeBackgroundColor #FFFFFF
skinparam DatabaseBorderColor #1F2A6B
skinparam DatabaseBackgroundColor #FFF7DC
skinparam ClassBorderColor #1F2A6B
skinparam ClassBackgroundColor #FCF8E8
skinparam ClassHeaderBackgroundColor #FFF7DC
skinparam EntityBorderColor #1F2A6B
skinparam EntityBackgroundColor #FCF8E8
skinparam ActivityBorderColor #1F2A6B
skinparam ActivityBackgroundColor #FCF8E8
skinparam ActivityDiamondBorderColor #1F2A6B
skinparam ActivityDiamondBackgroundColor #FFF7DC
skinparam SwimlaneBorderColor #1F2A6B
skinparam SequenceLifeLineBorderColor #1F2A6B
skinparam ParticipantBorderColor #1F2A6B
skinparam ParticipantBackgroundColor #FCF8E8
skinparam SequenceGroupBorderColor #1F2A6B
skinparam NoteBorderColor #1F2A6B
skinparam NoteBackgroundColor #FFFFFF
skinparam TitleFontSize 16
title Secuencia — Facturar con crédito directo
autonumber
actor Vendedor
participant "Cliente\n(consola / escritorio /\nweb / móvil)" as CLI
participant "InvoiceResource" as IR
participant "FacturacionServices" as FS
database "BD comercializadora" as BDC
participant "ClienteBanquitoRest" as CB
participant "CreditResource\n(BanQuito)" as CR
participant "CreditoServices" as CS
database "BD banquito" as BDB

Vendedor -> CLI : carrito, CREDITO, cédula, cuotas
CLI -> IR : POST /invoices (JSON)
IR -> FS : facturar(solicitud)
FS -> BDC : buscarCelular(cod) por cada línea
BDC --> FS : celulares y precios
FS -> CB : verificarSujetoCredito(cedula)
CB -> CR : GET /credits/eligibility/{cedula}
CR -> CS : verificarSujetoCredito
CS -> BDB : cliente, depósitos del último mes,\ncrédito activo
CS --> CB : sujetoCredito, codCliente
alt no es sujeto de crédito
  FS --> CLI : 400 CRED-001 + motivo
else es sujeto de crédito
  FS -> CB : obtenerMontoMaximo(codCliente)
  CB -> CR : GET /credits/max-amount/{codCliente}
  CR -> CS : obtenerMontoMaximo
  CS -> BDB : promedios de depósitos y retiros (3 meses)
  CS --> CB : montoMaximo
  alt total > monto máximo
    FS --> CLI : 400 CRED-002 + montoMaximo
  else total <= monto máximo
    FS -> CB : otorgarCredito(codCliente, total, cuotas)
    CB -> CR : POST /credits
    CR -> CS : otorgarCredito
    CS -> CS : calcularTablaAmortizacion
    CS -> BDB : INSERT CREDITO + TABLA_AMORTIZACION
    CS --> CB : codCredito, valorCuota, tabla
    FS -> BDC : INSERT COMPRADOR, FACTURA, DETALLE_FACTURA
    FS --> IR : Respuesta OK (factura + tabla)
    IR --> CLI : 200 JSON
    CLI --> Vendedor : factura y tabla de amortización
  end
end
@enduml
