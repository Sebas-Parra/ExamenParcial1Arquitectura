skinparam TitleFontSize 16
title Secuencia — Verificar sujeto de crédito en el Banco BanQuito (CU-01)
autonumber
participant "Comercializadora\n(ClienteBanquitoRest)" as COM
participant "CreditResource" as CR
participant "CreditoServices" as CS
participant "RepositorioBanquitoJdbc" as RB
database "BD banquito" as BDB

COM -> CR : GET /credits/eligibility/{cedula}
CR -> CS : verificarSujetoCredito(cedula)
CS -> RB : buscarClientePorCedula(cedula)
RB -> BDB : SELECT CLIENTE
alt no es cliente
  CS --> COM : OK, sujetoCredito=false (no es cliente)
else es cliente
  CS -> RB : tieneDepositoDesde(codCliente, hoy − 1 mes)
  RB -> BDB : SELECT MOVIMIENTO tipo DEP
  CS -> CS : si género = M, edad >= 25
  CS -> RB : tieneCreditoActivo(codCliente)
  RB -> BDB : SELECT CREDITO estado ACTIVO
  CS --> CR : Respuesta (sujetoCredito, motivo, codCliente)
  CR --> COM : 200 JSON
end
@enduml
