@startuml
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #1F2A6B
skinparam ArrowFontColor #8B1A1A
skinparam ArrowFontSize 11
skinparam ActorBorderColor #1F2A6B
skinparam ActorBackgroundColor #FCF8E8
skinparam UsecaseBorderColor #1F2A6B
skinparam UsecaseBackgroundColor #FCF8E8
skinparam RectangleBorderColor #1F2A6B
skinparam PackageBorderColor #1F2A6B
skinparam ComponentBorderColor #1F2A6B
skinparam ComponentBackgroundColor #FFF7DC
skinparam NodeBorderColor #1F2A6B
skinparam NodeBackgroundColor #FFFFFF
skinparam DatabaseBorderColor #1F2A6B
skinparam DatabaseBackgroundColor #FFF7DC
skinparam ClassBorderColor #1F2A6B
skinparam ClassBackgroundColor #FCF8E8
skinparam ClassHeaderBackgroundColor #FFF7DC
skinparam EntityBorderColor #1F2A6B
skinparam EntityBackgroundColor #FCF8E8
skinparam ActivityBorderColor #1F2A6B
skinparam ActivityBackgroundColor #FCF8E8
skinparam ActivityDiamondBorderColor #1F2A6B
skinparam ActivityDiamondBackgroundColor #FFF7DC
skinparam SwimlaneBorderColor #1F2A6B
skinparam SequenceLifeLineBorderColor #1F2A6B
skinparam ParticipantBorderColor #1F2A6B
skinparam ParticipantBackgroundColor #FCF8E8
skinparam SequenceGroupBorderColor #1F2A6B
skinparam NoteBorderColor #1F2A6B
skinparam NoteBackgroundColor #FFFFFF
skinparam TitleFontSize 16
title Diagrama de arquitectura — Comercializadora de Celulares y Módulo de Crédito BanQuito
left to right direction

rectangle "Clientes de la Comercializadora (MVC)" as CLIENTES {
  component "Cliente Consola\nCLI_CON_COM_CEL_JAVA_REST\nJava 21, HttpClient + Gson" as CON
  component "Cliente Escritorio\nCLI_ESC_COM_CEL_JAVA_REST\nJava Swing, HttpClient + Gson" as ESC
  component "Cliente Web\nCLI_WEB_COM_CEL_JAVA_REST\nServlets + JSP (Payara)" as WEB
  component "Cliente Móvil\nCLI_MOV_COM_CEL_JAVA_REST\nAndroid, HttpURLConnection + org.json" as MOV
}

node "Servidor de aplicaciones Payara (Jakarta EE 11)" as PAYARA {
  rectangle "Aplicación 1: WS_COM_CEL_JAVA_REST  /api" as APPCOM {
    component "Recursos JAX-RS\n/phones  /invoices  /credits" as RCOM
    component "Servicios\nCatalogoServices\nFacturacionServices" as SCOM
    component "ClienteBanquitoRest\n(integración con el banco)" as INT
    component "RepositorioComercializadoraJdbc" as DCOM
  }
  rectangle "Aplicación 2: WS_BANQUITO_JAVA_REST  /api" as APPBAN {
    component "CreditResource JAX-RS\n/credits/eligibility/{cedula}\n/credits/max-amount/{codCliente}\nPOST /credits\n/credits/{id}/amortization" as RBAN
    component "CreditoServices\nreglas de crédito y\ntabla de amortización" as SBAN
    component "RepositorioBanquitoJdbc" as DBAN
  }
}

database "MariaDB\ncomercializadora\nCELULAR, COMPRADOR,\nFACTURA, DETALLE_FACTURA" as BDC
database "MariaDB\nbanquito (Core)\nCLIENTE, CUENTA, MOVIMIENTO,\nCREDITO, TABLA_AMORTIZACION" as BDB

CON --> RCOM : HTTP + JSON
ESC --> RCOM : HTTP + JSON
WEB --> RCOM : HTTP + JSON
MOV --> RCOM : HTTP + JSON\n(10.0.2.2 / IP / ngrok)
RCOM --> SCOM
SCOM --> DCOM
SCOM --> INT
DCOM --> BDC : JDBC
INT --> RBAN : HTTP + JSON (REST)
RBAN --> SBAN
SBAN --> DBAN
DBAN --> BDB : JDBC
@enduml
